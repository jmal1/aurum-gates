{
  "name": "@jmal1/aurum-gates",
  "version": "1.11.0",
  "description": "Aurum quality gate mechanics: modes, shrink-only baselines, the failure message and the baseline guard (DS-059 §4.1).",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/aurum-education/aurum-gates.git"
  },
  "bin": {
    "aurum-gates": "bin/aurum-gates.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./gate": "./src/gate.mjs",
    "./guard": "./src/guard.mjs",
    "./sast": "./src/sast.mjs",
    "./eslint": "./src/eslint.mjs"
  },
  "files": [
    "bin",
    "src",
    "sast/rules/aurum.yml"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "test": "mkdir -p reports && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml \"test/*.test.mjs\"",
    "test:rules": "semgrep --test --config sast/rules sast/rules",
    "format:check": "prettier --check .",
    "check:no-skips": "node scripts/check-no-skips.mjs",
    "check:honest-tests": "node bin/aurum-gates.mjs run honest-tests"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
